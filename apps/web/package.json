{
  "name": "@jdhp/web",
  "version": "0.1.0",
  "private": true,
  "description": "Jordanian Digital Heritage Platform: web application (Next.js 15, Arabic first).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @jdhp/design-tokens build && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jdhp/design-tokens": "workspace:*",
    "@jdhp/schemas": "workspace:*",
    "ioredis": "^5.8.2",
    "next": "15.5.24",
    "next-intl": "^4.3.9",
    "openid-client": "^6.8.1",
    "openseadragon": "^5.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.37.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.9",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-security": "^3.0.1",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
