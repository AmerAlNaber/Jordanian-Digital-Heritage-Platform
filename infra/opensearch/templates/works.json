{
  "index_patterns": ["jdhp-works*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {"number_of_shards": 1, "number_of_replicas": 1},
      "analysis": {
        "char_filter": {
          "arabic_marks": {"type": "pattern_replace", "pattern": "[\\u064B-\\u0652\\u0670\\u0640\\u06D6-\\u06ED]", "replacement": ""},
          "arabic_letters": {"type": "mapping", "mappings": ["أ=>ا", "إ=>ا", "آ=>ا", "ٱ=>ا", "ة=>ه", "ى=>ي", "ؤ=>و", "ئ=>ي"]}
        },
        "filter": {
          "arabic_stop": {"type": "stop", "stopwords": "_arabic_"},
          "english_stop": {"type": "stop", "stopwords": "_english_"},
          "arabic_stemmer": {"type": "stemmer", "language": "arabic"},
          "english_stemmer": {"type": "stemmer", "language": "english"}
        },
        "analyzer": {
          "arabic_heritage": {"type": "custom", "char_filter": ["arabic_marks", "arabic_letters"], "tokenizer": "icu_tokenizer", "filter": ["lowercase", "icu_normalizer", "arabic_normalization", "arabic_stop", "arabic_stemmer", "icu_folding"]},
          "arabic_exact": {"type": "custom", "char_filter": ["arabic_marks", "arabic_letters"], "tokenizer": "icu_tokenizer", "filter": ["lowercase", "icu_normalizer", "arabic_normalization"]},
          "latin_heritage": {"type": "custom", "tokenizer": "icu_tokenizer", "filter": ["lowercase", "icu_folding", "english_stop", "english_stemmer"]}
        }
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "work_id": {"type": "keyword"},
        "public_id": {"type": "keyword"},
        "title_ar": {"type": "text", "analyzer": "arabic_heritage", "fields": {"exact": {"type": "text", "analyzer": "arabic_exact"}, "raw": {"type": "keyword"}}},
        "title_translit": {"type": "text", "analyzer": "latin_heritage"},
        "title_en": {"type": "text", "analyzer": "latin_heritage"},
        "description_ar": {"type": "text", "analyzer": "arabic_heritage"},
        "description_en": {"type": "text", "analyzer": "latin_heritage"},
        "agents": {"type": "text", "analyzer": "arabic_heritage", "fields": {"raw": {"type": "keyword"}}},
        "subjects": {"type": "keyword"},
        "places": {"type": "keyword"},
        "periods": {"type": "keyword"},
        "collections": {"type": "keyword"},
        "language": {"type": "keyword"},
        "date_earliest": {"type": "date", "format": "yyyy-MM-dd", "ignore_malformed": true},
        "date_latest": {"type": "date", "format": "yyyy-MM-dd", "ignore_malformed": true},
        "access_class": {"type": "keyword"},
        "publish_state": {"type": "keyword"},
        "frozen": {"type": "boolean"}
      }
    }
  },
  "_meta": {"description": "Work metadata with the Arabic analyzer; boosted above page text in queries (SRCH-1)."}
}
