# Cantaloupe configuration for the platform (rendered by entrypoint.sh).
# Tiles only, no derivative cache, authorization by the gateway's signed header (SEC-10, SEC-24).

http.enabled = true
http.host = 0.0.0.0
http.port = 8182
https.enabled = false
http.accept_queue_limit = 0
http.min_threads = 5
http.max_threads = 50
base_uri =
slash_substitute = %2F
max_pixels = 4000000
max_scale = 1.0
print_stack_trace_on_error_pages = false

endpoint.iiif.1.enabled = false
endpoint.iiif.2.enabled = false
endpoint.iiif.3.enabled = true
endpoint.iiif.min_size = 64
endpoint.iiif.min_tile_size = 256
# The gateway is the only client and already confines every request to the sizes and area its own
# info.json advertises (SEC-10); Cantaloupe's size list would refuse the gateway's region tiles.
endpoint.iiif.restrict_to_sizes = false
endpoint.iiif.content_disposition = inline
endpoint.admin.enabled = false
endpoint.api.enabled = false
endpoint.health.enabled = true
endpoint.health.dependency_check = false

# No server-side caches: the gateway and the CDN cache tiles. The cache worker must still carry a
# positive interval; Cantaloupe 5.0.7 exits silently when the key is missing.
cache.server.worker.enabled = false
cache.server.worker.interval = 86400

delegate_script.enabled = true
delegate_script.pathname = /etc/cantaloupe/delegates.rb
delegate_script.cache.enabled = false

source.static = S3Source
S3Source.endpoint = ${JDHP_S3_ENDPOINT_URL}
S3Source.region = ${JDHP_S3_REGION}
S3Source.access_key_id = ${JDHP_S3_ACCESS_KEY}
S3Source.secret_key = ${JDHP_S3_SECRET_KEY}
S3Source.lookup_strategy = ScriptLookupStrategy
S3Source.BasicLookupStrategy.bucket.name = ${JDHP_BUCKET_ACCESS}
S3Source.chunking.enabled = true
S3Source.chunking.chunk_size = 512K
S3Source.chunking.cache.enabled = true
S3Source.chunking.cache.max_size = 5M

processor.selection_strategy = ManualSelectionStrategy
processor.ManualSelectionStrategy.jp2 = OpenJpegProcessor
processor.ManualSelectionStrategy.tif = Java2dProcessor
processor.ManualSelectionStrategy.fallback = Java2dProcessor
processor.stream_retrieval_strategy = StreamStrategy
processor.fallback_retrieval_strategy = CacheStrategy
processor.downscale_filter = bicubic
processor.upscale_filter = bicubic
processor.sharpen = 0
processor.background_color = black
processor.jpg.quality = 85
processor.jpg.progressive = false
processor.imageio.jpg.quality = 85
OpenJpegProcessor.path_to_binaries = /usr/bin

# Never store a complete page set that could be reassembled (image and file specifications).
cache.server.derivative.enabled = false
cache.server.source = FilesystemCache
cache.server.source.ttl_seconds = 600
cache.server.info.enabled = true
cache.server.info.ttl_seconds = 3600
cache.server.purge_missing = true
cache.server.worker.enabled = true
FilesystemCache.pathname = /var/cache/cantaloupe
cache.client.enabled = false

overlays.enabled = false
redaction.enabled = false

log.application.level = info
log.application.ConsoleAppender.enabled = true
log.access.ConsoleAppender.enabled = true
