# Reverse proxy for local and pilot stacks. The routes live in routes.caddy so the testing rig's
# Caddyfile can add its protected test inbox around the same site (ADR-0010). TLS is automatic for
# public hostnames; localhost is plain.
{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/routes.caddy

{$JDHP_PUBLIC_HOST:localhost:8080} {
	import jdhp_routes
}
