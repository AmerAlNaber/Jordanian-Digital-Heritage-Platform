# Jordanian Digital Heritage Platform: every configuration variable, documented, with no real values.
# Copy to .env for local development. Deployments mount secrets as files instead (SEC-19) and set
# JDHP_SECRETS_DIR to the directory; each file is named after the variable in lower case.
#
# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment ---------------------------------------------------------------------------------
JDHP_ENV=local                      # local | test | ci | staging | pilot | production
JDHP_DEBUG=false                    # refused outside local and test
JDHP_LOG_LEVEL=INFO
JDHP_PUBLIC_BASE_URL=http://localhost:8080
JDHP_PUBLIC_HOST=:8080              # Caddy site address; a public hostname enables automatic TLS
JDHP_HTTP_PORT=8080

# --- Database (roles created by infra/compose/postgres/init-roles.sh) ----------------------------
POSTGRES_PASSWORD=change-me-postgres-superuser
JDHP_DB_MIGRATE_PASSWORD=change-me-migrate        # owner role, runs Alembic only
JDHP_DB_APP_PASSWORD=change-me-app                # API role, subject to row-level security
JDHP_DB_WORKER_PASSWORD=change-me-worker          # pipeline role, least privilege
KC_DB_PASSWORD=change-me-keycloak-db

# --- Redis, OpenSearch, Cerbos --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
# JDHP_OPENSEARCH_USER=                           # unset when the security plugin is disabled (local)
# JDHP_OPENSEARCH_PASSWORD=
# JDHP_CERBOS_URL is wired by compose; set it explicitly when running the API outside compose.

# --- Identity (Keycloak) --------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KC_WEB_CLIENT_SECRET=change-me-web-client-secret
KC_STAFF_CLIENT_SECRET=change-me-staff-client-secret
KC_SSL_REQUIRED=external            # "all" in deployments
KC_DEV_USER_PASSWORD=change-me-dev-users          # local-only test accounts (compose profile local-users)
JDHP_PWNED_RANGE_URL=https://api.pwnedpasswords.com/range   # k-anonymity range API for the breached-password policy (SEC-4)
JDHP_BREACHED_PASSWORD_FAIL_CLOSED=false  # true refuses passwords while the range API is unreachable (ADR-0009)
WEB_SESSION_SECRET=change-me-web-session-secret-at-least-32-chars

# --- Object storage (MinIO locally; S3-compatible elsewhere) ---------------------------------------
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root
JDHP_S3_ACCESS_KEY=jdhp-app                        # API and worker: access, uploads, exports; never preservation
JDHP_S3_SECRET_KEY=change-me-app-secret
JDHP_S3_INGEST_ACCESS_KEY=jdhp-ingest              # ingest worker only: writes preservation once
JDHP_S3_INGEST_SECRET_KEY=change-me-ingest-secret
JDHP_BUCKET_PRESERVATION=jdhp-preservation
JDHP_BUCKET_ACCESS=jdhp-access
JDHP_BUCKET_UPLOADS=jdhp-uploads
JDHP_BUCKET_EXPORTS=jdhp-exports
JDHP_BUCKET_AUDIT_ARCHIVE=jdhp-audit-archive

# --- Keys (32+ characters; rotate yearly or on suspected exposure) ---------------------------------
JDHP_TOKEN_SIGNING_KEY=change-me-token-signing-key-32-chars-min
JDHP_FORENSIC_MASTER_KEY=change-me-forensic-master-key-32-chars
JDHP_FIELD_ENCRYPTION_KEY=change-me-field-encryption-key-32-chars
JDHP_IMAGE_INTERNAL_KEY=change-me-image-gateway-to-cantaloupe-key
JDHP_IMAGE_SOURCE=cantaloupe         # cantaloupe (the image server named in SPEC.md) | libvips (the gateway crops JP2 itself; ADR-0005)
JDHP_TILE_SIZE=512                   # IIIF tile edge advertised in info.json
JDHP_TILE_MAX_PIXELS=1048576         # largest pixel area one tile response may carry (SEC-10)

# --- Identifiers (ADR-0001 D10) ---------------------------------------------------------------------
JDHP_ARK_NAAN=99999                  # the ARK test NAAN until the institution's NAAN is assigned
JDHP_ARK_SHOULDER_WORK=w8
JDHP_ARK_SHOULDER_COLLECTION=c8
JDHP_ARK_SHOULDER_AGENT=a8

# --- Providers behind adapters (mock is refused in pilot and production, TRN-6) --------------------
JDHP_OCR_PROVIDER=mock               # mock | azure | kraken
JDHP_LLM_PROVIDER=mock               # mock | claude
JDHP_EMBEDDING_PROVIDER=mock         # mock (model chosen in Phase 3, ADR-0001 D7)
JDHP_EMBEDDING_DIMENSIONS=1024
JDHP_PAYMENT_PROVIDER=mock           # mock | hyperpay
JDHP_EMAIL_PROVIDER=mock             # mock | smtp
JDHP_SMS_PROVIDER=mock
JDHP_ACCESS_DERIVATIVE_FORMAT=jp2    # jp2 | ptif

# --- Retention (ADR-0001 D16) -------------------------------------------------------------------------
JDHP_RETENTION_AUDIT_YEARS=7
JDHP_RETENTION_IDENTITY_DOCUMENT_DAYS=30
JDHP_RETENTION_INACTIVE_ACCOUNT_YEARS=2

# --- Reader and content protection (RDR-5, SEC-10, SEC-12, SEC-15) ------------------------------------
JDHP_READER_IDLE_TIMEOUT_SECONDS=1800
JDHP_GRANT_CACHE_TTL_SECONDS=60
JDHP_TILE_TOKEN_TTL_SECONDS=300
JDHP_DOWNLOAD_URL_TTL_SECONDS=900
JDHP_TILE_RATE_BURST_PAGES_PER_SECOND=3
JDHP_TILE_RATE_SUSTAINED_PER_MINUTE=600
JDHP_HEARTBEAT_INTERVAL_SECONDS=60
JDHP_GRANT_TOKEN_TTL_SECONDS=600         # reader credential lifetime, refreshed by the heartbeat (SEC-2)
JDHP_ANONYMOUS_SESSION_MAX_SECONDS=28800 # longest anonymous reading session on an Open work (RDR-5)
JDHP_REGISTERED_GRANT_DAYS=30            # lifetime of the grant a member receives on a Registered work (ACS-2)
JDHP_DEFAULT_DEVICE_LIMIT=2              # concurrent devices per grant (ACS-2)
JDHP_PRINT_QUOTA_DEFAULT_PAGES=20        # print quota per grant unless staff set another (RDR-4)
JDHP_PRINT_PPI=150                       # resolution the print PDF declares for its page images (RDR-4)
JDHP_PRINT_MAX_EDGE_PX=1754              # longest edge of a printed page in pixels (A4 at 150 ppi)

# --- Seed ---------------------------------------------------------------------------------------------
JDHP_SEED_SCALE=1.0                  # 1.0 renders 400 ppi masters (about 640 MB); 0.35 for a quick demo

# --- Observability --------------------------------------------------------------------------------------
# JDHP_SENTRY_DSN=
# JDHP_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
