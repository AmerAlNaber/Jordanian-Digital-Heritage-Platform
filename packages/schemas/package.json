{
  "name": "@jdhp/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "The API's OpenAPI document and the TypeScript types generated from it. Regenerated on every API change (make openapi).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/api.d.ts --alphabetize",
    "lint": "echo 'generated package'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
