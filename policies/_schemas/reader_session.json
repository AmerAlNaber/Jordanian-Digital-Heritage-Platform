{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attributes of a reader session",
  "type": "object",
  "properties": {
    "owner_id": { "type": "string" },
    "token_valid": { "type": "boolean" },
    "state": { "type": "string", "enum": ["active", "expired", "revoked", "suspended"] }
  },
  "required": ["token_valid"]
}
